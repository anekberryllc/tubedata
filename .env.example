# Copy to .env.local and fill in. Never commit .env.local.
YOUTUBE_API_KEY=
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe (test mode). Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=

# Outbound email (Gmail SMTP, Google Workspace mailbox).
# SMTP_PASS is a 16-character App Password from
# myaccount.google.com/apppasswords - NOT the account password.
# Requires 2-Step Verification on the account. Leave blank in dev:
# with no credentials the app logs what it would have sent and carries on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sending identity. Defaults to the support address; set only if the From
# must differ from it (e.g. a provider that verifies a subdomain sender).
MAIL_FROM=
